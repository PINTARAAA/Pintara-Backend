NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://pintara:pintara@localhost:5432/pintara?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="ganti-dengan-string-acak-minimal-16-karakter"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=900
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20
CACHE_TTL_SECONDS=60

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# S3-compatible (MinIO/R2/S3) - dipakai bila STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=pintara
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
